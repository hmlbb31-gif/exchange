# --- Telegram (пока не нужно для сухого прогона) ---
BOT_TOKEN=
ADMIN_IDS=

# --- MangaBuff сессия (первый аккаунт) ---
MB_COOKIE=
MB_COOKIE_FILE=cookies.txt
# ВАЖНО: замени на СВОЙ User-Agent из того же браузера, где снял куки
# (chrome://version или navigator.userAgent). Иначе DDoS-Guard отвергнет куки.
MB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

# --- Поведение ---
DRY_RUN=1
REQUESTS_PER_MINUTE=20
BASE_URL=https://mangabuff.ru

# --- Шифрование кук в БД (пока не нужно) ---
FERNET_KEY=
