# === Бот-ОБМЕНЩИК (1 аккаунт) ===

# --- Telegram ---
EXCHANGE_BOT_TOKEN=   # токен бота-обменщика (@BotFather). Fallback: BOT_TOKEN
BOT_TOKEN=
ADMIN_IDS=            # твой telegram id, через запятую

# --- MangaBuff сессия (аккаунт обменщика) ---
# НЕОБЯЗАТЕЛЬНО: куку удобнее привязать прямо в боте кнопкой «Привязать аккаунт»
# (она сохранится в БД зашифрованной и переживёт перезапуск). Эти переменные
# нужны только для первого старта «по-старому» без кнопки.
# Кука либо строкой Cookie-заголовка, либо путь к cookies.txt (Netscape).
MB_COOKIE=
MB_COOKIE_FILE=cookies.txt
# ВАЖНО: UA должен совпадать с браузером, из которого экспортированы куки
# (DDoS-Guard привязывает куки к User-Agent).
MB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.0.0 Safari/537.36

# --- Поведение ---
DRY_RUN=1            # 1 = сухой прогон (НЕ жмёт accept/reject, только логирует)
REQUESTS_PER_MINUTE=20
BASE_URL=https://mangabuff.ru

# --- Шифрование кук в БД ---
FERNET_KEY=          # сгенерировать: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# --- Анти-детект (можно не трогать, значения по умолчанию разумные) ---
# Человеческая пауза перед каждым запросом и TTL кэша рынка задаются в config.py:
#   humanize_min/max, market_ttl, daily_request_cap.
